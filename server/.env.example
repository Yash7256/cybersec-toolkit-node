# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the server listens on (1-65535)
PORT=3001
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (valid URL origins only)
CORS_ORIGINS=http://localhost:5173
# Number of proxy hops to trust for X-Forwarded-* headers (0 = trust none)
TRUST_PROXY=0
# Rate limit window in milliseconds (minimum 1000)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per IP (minimum 1)
RATE_LIMIT_MAX=100
# Express body-parser limit string, e.g. 100kb
BODY_LIMIT=100kb
# Pooled Postgres connection string used at runtime (postgres:// or postgresql://)
DATABASE_URL=postgresql://user:password@localhost:5432/cybersec
# Direct Postgres connection for CLI/migrations (not pooled; keep separate from DATABASE_URL when behind a pooler)
DIRECT_URL=postgresql://user:password@localhost:5432/cybersec
# Max connections per pg pool in the app process (minimum 1)
DB_POOL_MAX=10
# Per-statement timeout in milliseconds (0 = disabled)
DB_STATEMENT_TIMEOUT_MS=10000
# Idle-in-transaction session timeout in milliseconds (0 = disabled)
DB_IDLE_TX_TIMEOUT_MS=15000
# Clerk publishable key (starts with pk_; copy from your Clerk app)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Clerk secret key (starts with sk_; never commit a real value)
CLERK_SECRET_KEY=sk_test_xxx
# Clerk webhook signing secret (starts with whsec_; leave empty in dev, required in production)
CLERK_WEBHOOK_SIGNING_SECRET=
# Free-tier daily limit per tool
FREE_DAILY_LIMIT=5
# Paid-tier daily limit per tool
PAID_DAILY_LIMIT=100
# Redis connection string (redis:// or rediss://). Tests use a separate DB index.
REDIS_URL=redis://localhost:6379
# Allow private/reserved scan targets (development/test only; production refuses to boot)
ALLOW_PRIVATE_TARGETS=false
# Bearer token for GET /metrics (min 24 chars; leave empty to disable the endpoint)
METRICS_TOKEN=
# DNS resolution timeout in milliseconds
DNS_TIMEOUT_MS=3000
# General per-user request limit per minute
USER_RATE_LIMIT_MAX=300
# Tool-submission limits per minute (per user / per IP)
SUBMIT_RATE_LIMIT_USER=10
SUBMIT_RATE_LIMIT_IP=30
# Failed-auth guard: max failures per window, window and block seconds
AUTH_FAIL_MAX=20
AUTH_FAIL_WINDOW_SEC=600
AUTH_FAIL_BLOCK_SEC=900
# Victim protection: scans of one target per hour (all users / per user)
TARGET_HOURLY_LIMIT_GLOBAL=20
TARGET_HOURLY_LIMIT_USER=5
# Blocked-attempt cooldown: max blocks per window, window and cooldown seconds
BLOCKED_ATTEMPTS_MAX=5
BLOCKED_ATTEMPTS_WINDOW_SEC=600
BLOCKED_COOLDOWN_SEC=900
# Tool execution
HTTP_USER_AGENT=CyberSecToolkit/1.0
TOOL_HARD_TIMEOUT_MS=30000
MAX_CONCURRENT_TOOL_RUNS=50
SSL_AUDIT_TIMEOUT_MS=20000
WHOIS_TIMEOUT_MS=8000
WHOIS_CACHE_TTL_SEC=3600
WHOIS_PRIVACY_PATTERNS=privacy,redacted,whoisguard,domains by proxy,contact privacy,data protected,private registration,withheld
WHOIS_SUSPICIOUS_STATUS_TOKENS=hold,pendingdelete,redemptionperiod,serverdeleteprohibited,clienthold
GEOIP_PROVIDER_ORDER=ipinfo,ipwhois
IPINFO_API_TOKEN=
GEOIP_TIMEOUT_MS=5000
GEOIP_CACHE_TTL_SEC=3600
GEOIP_RATE_PER_MIN=55
GEOIP_MAX_CONCURRENT=5
GEOIP_MAX_IPS=4
GEOIP_CONSENSUS=false
GEOIP_ALLOW_INSECURE_PROVIDER=false
GEOIP_REPUTATION_ENABLED=true
GEOIP_DNSBL_ZONES=zen.spamhaus.org,bl.spamcop.net
GEOIP_BULK_MAX_FREE=10
GEOIP_BULK_MAX_PAID=100
GEOIP_REVERSE_IP=false
SHARE_DEFAULT_TTL_DAYS=7
PING_METHOD=auto
PING_HISTORY_TTL_SEC=3600
# Port scanner / enrichment
SCAN_MAX_CONCURRENCY=200
SCAN_DEFAULT_CONCURRENCY=100
SCAN_RATE_CONN_PER_SEC=300
SCAN_GLOBAL_MAX_SOCKETS=1500
SCAN_TIMEOUT_MS=300000
NVD_API_KEY=
NVD_CACHE_TTL_HOURS=24
NVD_MAX_RESULTS_PER_SERVICE=10
NVD_MIN_CVSS_SCORE=5.0
ABUSEIPDB_API_KEY=
THREAT_INTEL_SPAMHAUS=false
THREAT_INTEL_CACHE_TTL_SEC=3600
QUEUE_PREFIX=cst
WORKER_CONCURRENCY=10
WORKER_HEARTBEAT_SEC=15
RUN_STALL_SEC=120
RUN_MAX_ATTEMPTS=2
QUEUE_MAX_WAITING=1000
QUEUE_MAX_WAIT_SEC=900
ORPHAN_QUEUED_SEC=60
MAX_ACTIVE_RUNS_FREE=2
MAX_ACTIVE_RUNS_PAID=5
WORKER_SHUTDOWN_GRACE_MS=25000
RUN_EMBEDDED_WORKER=true
WORKER_HEALTH_PORT=3002
MAINTENANCE_ENABLED=true
RETENTION_DAYS_FREE=90
RETENTION_DAYS_PAID=365
RETENTION_USAGE_DAYS=400
RETENTION_WEBHOOK_DAYS=30
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES=50
RETENTION_DRY_RUN=false
SUBDOMAIN_DNS_CONCURRENCY=20
SUBDOMAIN_HTTP_CONCURRENCY=10
SUBDOMAIN_HTTP_TIMEOUT_MS=5000
SUBDOMAIN_WILDCARD_CHECKS=3
TRACEROUTE_TIMEOUT_MS=60000
TRACEROUTE_MAX_HOPS=30
TRACEROUTE_BINARY=traceroute
WEBAPP_SCAN_TIMEOUT_MS=120000
WEBAPP_REQUEST_TIMEOUT_MS=10000
WEBAPP_MAX_RESPONSE_BYTES=524288
WEBAPP_CHECK_CONCURRENCY=8
WEBAPP_SCAN_MAX_PAGES=100
WEBAPP_SCAN_TOTAL_TIMEOUT_SEC=180
WEBAPP_SCAN_USER_LIMIT_PER_DAY=10
WEBAPP_AUTH_ATTESTATION_COOLDOWN_SEC=60
