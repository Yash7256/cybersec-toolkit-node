# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the server listens on (1-65535)
PORT=3001
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (valid URL origins only)
CORS_ORIGINS=http://localhost:5173
# Number of proxy hops to trust for X-Forwarded-* headers (0 = trust none)
TRUST_PROXY=0
# Rate limit window in milliseconds (minimum 1000)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per IP (minimum 1)
RATE_LIMIT_MAX=100
# Express body-parser limit string, e.g. 100kb
BODY_LIMIT=100kb
