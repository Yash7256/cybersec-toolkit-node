{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:db": "vitest run --project db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node -e \"if(process.env.NODE_ENV==='production'){console.error('Refusing db:reset in production');process.exit(1)}\" && prisma migrate reset --force",
    "db:studio": "prisma studio",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.7.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^1.9.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.4.1",
    "svix": "^2.10.0",
    "tldts": "^7.4.22",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "selfsigned": "^5.5.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
